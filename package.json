{
  "name": "vue-multiselect",
  "version": "4.0.0-alpha.0",
  "private": false,
  "type": "module",
  "types": "dist/index.d.ts",
  "homepage": "vue-multiselect.js.org",
  "description": "Multiselect component for Vue",
  "author": {
    "name": "Damian Dulisz",
    "email": "damian@dulisz.com"
  },
  "contributors": [
    "Matt Elen <matt@suade.org>",
    "Akshay Jat <https://github.com/akki-jat>"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "bundle": "npm run build",
    "finish": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev": "vite serve documentation",
    "predocs:build": "node -e \"require('node:fs').rmSync('docs/assets',{recursive:true,force:true})\"",
    "docs:build": "vite build documentation",
    "docs:preview": "vite preview documentation"
  },
  "main": "dist/vue-multiselect.cjs",
  "module": "dist/vue-multiselect.esm.js",
  "unpkg": "dist/vue-multiselect.umd.js",
  "jsdelivr": "dist/vue-multiselect.umd.js",
  "jsnext:main": "dist/vue-multiselect.esm.js",
  "style": "dist/vue-multiselect.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-multiselect.esm.js",
      "require": "./dist/vue-multiselect.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "sass": "1.102.0",
    "shiki": "4.4.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10",
    "vue": "3.5.41",
    "vue-tsc": "3.3.9",
    "vuex": "4.1.0"
  },
  "bugs": {
    "url": "https://github.com/shentao/vue-multiselect"
  },
  "engines": {
    "node": ">= 20.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shentao/vue-multiselect.git"
  }
}
